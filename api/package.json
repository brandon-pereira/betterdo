{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:production": "node -r dotenv/config ./dist/src/index.js",
    "build": "NODE_ENV=production tsc",
    "start": "tsx watch -r dotenv/config src/index.ts",
    "lint": "eslint . && tsc --noemit",
    "test": "vitest",
    "push": "NODE_OPTIONS='--import tsx' drizzle-kit push",
    "generate": "npx auth generate -y --output ./src/schema/auth.ts && npx prettier --write ./src/schema/auth.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.14",
    "@better-auth/core": "^1.7.14",
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@better-auth/mcp": "^1.7.14",
    "@better-auth/oauth-provider": "^1.7.14",
    "@better-auth/passkey": "^1.7.14",
    "@better-auth/utils": "0.5.1",
    "@better-fetch/fetch": "1.3.3",
    "@betterdo/shared": "1.0.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-auth": "^1.7.14",
    "better-call": "1.4.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "hono": "^4.13.3",
    "pg": "^8.23.0",
    "resend": "^6.22.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "web-notifier": "^2.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/pg": "^8.23.1",
    "auth": "^1.7.14",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "eslint": "^10.12.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.3"
  }
}
