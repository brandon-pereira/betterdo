# Postgres Database
DATABASE_URL=postgres://postgres:mypassword@localhost:5432/postgres

# Web Push Notifications
# Generate these keys using `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=noreply@example.com

# Public URL of this API server (default: http://localhost:4000).
# This is the canonical API base URL. BetterAuth uses it to build the OAuth
# redirect_uri sent to Google: ${SERVER_URL}/api/auth/callback/google, which
# must be registered as an "Authorized redirect URI" in the Google Cloud Console.
SERVER_URL=http://localhost:4000

# Google OAuth Credentials
# Replace with your actual Client ID and Secret.
# You can generate a new Web Client here: https://console.cloud.google.com/auth/clients/create.
# Use the SERVER_URL as the Javascript origin and callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (transactional email)
RESEND_API_KEY=
# EMAIL_FROM=BetterDo <onboarding@resend.dev>

# Used by BetterAuth for encryption and signing.
# Generate a key by running `npx @better-auth/cli@latest secret`
BETTER_AUTH_SECRET=