{
  "name": "api-v2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:production": "node ./dist/src/index.js",
    "build": "tsc",
    "start": "tsx watch -r dotenv/config src/index.ts",
    "lint": "eslint . && tsc --noemit",
    "test": "vitest",
    "push": "NODE_OPTIONS='--import tsx' drizzle-kit push",
    "generate": "npx auth generate -y --output ./src/schema/auth.ts && npx prettier --write ./src/schema/auth.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@better-auth/passkey": "^1.7.2",
    "@electric-sql/pglite": "^0.5.7",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.0",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "hono": "^4.13.3",
    "pg": "^8.23.0",
    "resend": "^6.22.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "web-notifier": "^2.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@types/pg": "^8.23.1",
    "auth": "^1.7.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "vitest": "^4.1.11"
  }
}
